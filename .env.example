# ============================================
# AI Career Copilot - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Server Configuration ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
# Local: mongodb://localhost:27017/ai-career-copilot
# Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ai-career-copilot
MONGODB_URI=mongodb://localhost:27017/ai-career-copilot

# --- JWT Secret ---
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# --- AI Configuration ---
# Option 1: OpenAI API (recommended for IBM Bob compatible integration)
OPENAI_API_KEY=your_openai_api_key_here

# Option 2: IBM watsonx.ai (uncomment and fill if using IBM watsonx)
# IBM_WATSONX_API_KEY=your_ibm_watsonx_api_key
# IBM_WATSONX_PROJECT_ID=your_project_id
# IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# --- Demo Mode ---
# Set to "true" to use demo data without a real AI API key
# Useful for testing and presentations
DEMO_MODE=false

# --- Client URL (for CORS) ---
CLIENT_URL=http://localhost:3000
